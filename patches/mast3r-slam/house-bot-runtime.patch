+class TCPStreamDataset(MonocularDataset):
+    def __init__(self, stream_uri):
+        super().__init__()
+        if av is None:
+            raise RuntimeError("PyAV is required for TCP live streams")
+
+        parsed = urlparse(stream_uri)
+        if parsed.scheme not in ("tcp-listen", "tcp-connect") or parsed.port is None:
+            raise ValueError(
+                "TCP stream URI must use tcp-listen:// or tcp-connect://"
+            )
+
+        self.dataset_path = pathlib.Path("c920-live")
+        self.stream_uri = stream_uri
+        self.use_calibration = False
+        self.save_results = True
+        self._condition = threading.Condition()
+        self._latest_img = None
+        self._latest_timestamp = 0.0
+        self._latest_seq = -1
+        self._last_consumed_seq = -1
+        self._decode_error = None
+        self._started_at = time.monotonic()
+
+        host = parsed.hostname or "0.0.0.0"
+        query = parse_qs(parsed.query)
+        default_format = "mpegts" if parsed.scheme == "tcp-listen" else "mjpeg"
+        self._container_format = query.get("format", [default_format])[0]
+        if parsed.scheme == "tcp-listen":
+            self._server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+            self._server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+            self._server.bind((host, parsed.port))
+            self._server.listen(1)
+            print(f"Waiting for live stream on {host}:{parsed.port}", flush=True)
+            self._connection, address = self._server.accept()
+            self._server.close()
+        else:
+            print(f"Connecting to live stream at {host}:{parsed.port}", flush=True)
+            self._connection = socket.create_connection((host, parsed.port), timeout=15)
+            self._connection.settimeout(None)
+            address = self._connection.getpeername()
+        self._connection.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
+        print(
+            f"Live stream connected to {address[0]}:{address[1]} "
+            f"as {self._container_format}",
+            flush=True,
+        )
+
+        self._decoder = threading.Thread(target=self._decode_frames, daemon=True)
+        self._decoder.start()
+        self._wait_for_first_frame(timeout=15.0)
+
+    def __len__(self):
+        return 999999
+
+    def subsample(self, subsample):
+        del subsample
+
+    def _decode_frames(self):
+        try:
+            stream = self._connection.makefile("rb", buffering=0)
+            with av.open(
+                stream, mode="r", format=self._container_format
+            ) as container:
+                for frame in container.decode(video=0):
+                    img = frame.to_ndarray(format="rgb24")
+                    with self._condition:
+                        self._latest_img = img
+                        self._latest_timestamp = time.monotonic() - self._started_at
+                        self._latest_seq += 1
+                        self._condition.notify_all()
+        except Exception as exc:
+            with self._condition:
+                self._decode_error = exc
+                self._condition.notify_all()
+
+    def _wait_for_first_frame(self, timeout):
+        deadline = time.monotonic() + timeout
+        with self._condition:
+            while self._latest_img is None and self._decode_error is None:
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise TimeoutError("Timed out waiting for the first live frame")
+                self._condition.wait(remaining)
+            if self._decode_error is not None:
+                raise RuntimeError("Live stream decoder failed") from self._decode_error
+
+    def get_img_shape(self):
+        self._wait_for_first_frame(timeout=15.0)
+        with self._condition:
+            img = self._latest_img.copy()
+        raw_img_shape = img.shape
+        resized = resize_img(img, self.img_size)
+        return resized["img"][0].shape[1:], raw_img_shape[:2]
+
+    def read_img(self, idx):
+        del idx
+        with self._condition:
+            while (
+                self._latest_seq <= self._last_consumed_seq
+                and self._decode_error is None
+            ):
+                self._condition.wait()
+            if self._decode_error is not None:
+                raise RuntimeError("Live stream decoder stopped") from self._decode_error
+            self._last_consumed_seq = self._latest_seq
+            img = self._latest_img.copy()
+            self.timestamps.append(self._latest_timestamp)
+        return img.astype(self.dtype)
+
