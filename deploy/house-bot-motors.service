[Unit]
Description=House Bot GPIO matrix motor service
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/james
ExecStart=/usr/bin/python3 /home/james/pi_motor_service.py --bind 0.0.0.0 --port 8765 --watchdog 0.35 --invert-left --invert-right --swap-sides
Restart=on-failure
RestartSec=1
KillSignal=SIGTERM

[Install]
WantedBy=default.target
